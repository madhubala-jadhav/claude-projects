{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "ExpenseInNutshell design tokens. Tool-agnostic W3C-style token file. Source of truth for design/figma-plugin/code.js (Figma paint + text styles) and for the CSS custom properties inlined into report.html. Contrast ratios are recorded in design-system.md. Categorical chart palette is the validated 8-hue reference palette; see design-system.md for the validator output.",
  "$version": "1.0.0",
  "$lastUpdated": "2026-08-26",

  "color": {
    "$type": "color",

    "light": {
      "$description": "Light theme. Surface for chart validation: #FFFFFF.",

      "surface": {
        "canvas":        { "$value": "#F4F6F9", "$description": "Page background behind cards" },
        "raised":        { "$value": "#FFFFFF", "$description": "Card / panel surface. The chart surface." },
        "sunken":        { "$value": "#EAEDF2", "$description": "Table header rows, inset wells, disabled fields" },
        "overlay":       { "$value": "#FFFFFF", "$description": "Popovers, tooltips, the drill-down panel" },
        "accentSubtle":  { "$value": "#E8F0FE", "$description": "Selected row, top-category callout background" },
        "dangerSubtle":  { "$value": "#FDE8E6", "$description": "Skipped-file rows, destructive confirmations" },
        "warningSubtle": { "$value": "#FFF3D6", "$description": "Uncategorized and needs-review rows" },
        "successSubtle": { "$value": "#E3F4EA", "$description": "Applied-corrections confirmation" }
      },

      "border": {
        "subtle":  { "$value": "#E1E5EC", "$description": "Table row rules, card outlines. Decorative; exempt from 3:1." },
        "strong":  { "$value": "#C3CAD6", "$description": "Section dividers, chart baseline" },
        "control": { "$value": "#767F8C", "$description": "Interactive control boundary. Meets WCAG 1.4.11 at 3:1." },
        "focus":   { "$value": "#1F5FD8", "$description": "Focus ring. 2px outline + 2px offset." }
      },

      "text": {
        "primary":   { "$value": "#12161D", "$description": "Headings, amounts, table values" },
        "secondary": { "$value": "#4B5566", "$description": "Labels, descriptions, secondary values" },
        "muted":     { "$value": "#676F7C", "$description": "Captions, axis ticks, timestamps. Still AA body." },
        "inverse":   { "$value": "#FFFFFF", "$description": "Text on accent / danger fills" },
        "accent":    { "$value": "#1F5FD8", "$description": "Links, interactive text" },
        "danger":    { "$value": "#B3261E", "$description": "Errors, skipped files, negative emphasis" },
        "warning":   { "$value": "#7A5200", "$description": "Uncategorized and needs-review labels" },
        "success":   { "$value": "#1A6E3D", "$description": "Confirmations, downward spend trend" }
      },

      "accent": {
        "default": { "$value": "#1F5FD8", "$description": "Primary button fill, active state" },
        "hover":   { "$value": "#17499F", "$description": "Primary button hover" }
      },

      "delta": {
        "up":   { "$value": "#B3261E", "$description": "Spend increased month over month. Always paired with a caret glyph and a % label." },
        "down": { "$value": "#1A6E3D", "$description": "Spend decreased month over month" },
        "flat": { "$value": "#676F7C", "$description": "No meaningful change" }
      },

      "chart": {
        "surface":  { "$value": "#FFFFFF", "$description": "The surface the chart renders on. Validator input." },
        "axis":     { "$value": "#8A94A3", "$description": "Axis lines and tick labels" },
        "grid":     { "$value": "#E6E9EF", "$description": "Hairline gridlines. Recessive by design." },
        "sliceGap": { "$value": "#8A94A3", "$description": "2px separator stroke drawn between adjacent pie slices. Doubles as the WCAG 1.4.11 non-text boundary at 3.07:1 on chart.surface, which is what keeps slots 3/4/5 usable despite their own fills measuring under 3:1." },
        "other":    { "$value": "#8A94A3", "$description": "Neutral fill for the aggregated 'Other' slice and for categories with slot: null. 3.07:1 on white." },
        "uncategorizedFill":  { "$value": "#FFF3D6", "$description": "Uncategorized slice base fill" },
        "uncategorizedHatch": { "$value": "#7A5200", "$description": "45-degree hatch ink over uncategorizedFill. 6.28:1 on that fill. Makes the accuracy gap unmissable per NFR6." },
        "series": {
          "$description": "Fixed categorical slots. Assigned by category identity, never by rank. Never cycled: a 9th category folds into chart.other.",
          "slot1": { "$value": "#2a78d6", "$description": "blue - default: Rent/Housing" },
          "slot2": { "$value": "#eb6834", "$description": "orange - default: Food & Dining" },
          "slot3": { "$value": "#1baf7a", "$description": "aqua - default: Groceries" },
          "slot4": { "$value": "#eda100", "$description": "yellow - default: Transport" },
          "slot5": { "$value": "#e87ba4", "$description": "magenta - default: Shopping" },
          "slot6": { "$value": "#008300", "$description": "green - default: Utilities" },
          "slot7": { "$value": "#4a3aa7", "$description": "violet - default: EMI/Loan Payments" },
          "slot8": { "$value": "#e34948", "$description": "red - default: Healthcare" }
        }
      }
    },

    "dark": {
      "$description": "Dark theme. Selected steps for the dark surface, not an automatic inversion. Surface for chart validation: #171B22.",

      "surface": {
        "canvas":        { "$value": "#0D1017" },
        "raised":        { "$value": "#171B22" },
        "sunken":        { "$value": "#0A0D13" },
        "overlay":       { "$value": "#1E232C" },
        "accentSubtle":  { "$value": "#16233C" },
        "dangerSubtle":  { "$value": "#3A1A18" },
        "warningSubtle": { "$value": "#3A2E10" },
        "successSubtle": { "$value": "#12301F" }
      },

      "border": {
        "subtle":  { "$value": "#262C37" },
        "strong":  { "$value": "#3B4351" },
        "control": { "$value": "#6C7686" },
        "focus":   { "$value": "#7CA8FF" }
      },

      "text": {
        "primary":   { "$value": "#F3F5F9" },
        "secondary": { "$value": "#B3BCCA" },
        "muted":     { "$value": "#949EAD" },
        "inverse":   { "$value": "#0D1017" },
        "accent":    { "$value": "#7CA8FF" },
        "danger":    { "$value": "#FF9A92" },
        "warning":   { "$value": "#FFC658" },
        "success":   { "$value": "#63D394" }
      },

      "accent": {
        "default": { "$value": "#7CA8FF" },
        "hover":   { "$value": "#A6C4FF" }
      },

      "delta": {
        "up":   { "$value": "#FF9A92" },
        "down": { "$value": "#63D394" },
        "flat": { "$value": "#949EAD" }
      },

      "chart": {
        "surface":  { "$value": "#171B22" },
        "axis":     { "$value": "#8B95A5" },
        "grid":     { "$value": "#262C37" },
        "sliceGap": { "$value": "#8B95A5", "$description": "5.71:1 on the dark chart surface" },
        "other":    { "$value": "#737E8E", "$description": "4.20:1 on the dark surface" },
        "uncategorizedFill":  { "$value": "#3A2E10" },
        "uncategorizedHatch": { "$value": "#FFC658", "$description": "8.54:1 on that fill" },
        "series": {
          "slot1": { "$value": "#3987e5", "$description": "blue" },
          "slot2": { "$value": "#d95926", "$description": "orange" },
          "slot3": { "$value": "#199e70", "$description": "aqua" },
          "slot4": { "$value": "#c98500", "$description": "yellow" },
          "slot5": { "$value": "#d55181", "$description": "magenta" },
          "slot6": { "$value": "#008300", "$description": "green" },
          "slot7": { "$value": "#9085e9", "$description": "violet" },
          "slot8": { "$value": "#e66767", "$description": "red" }
        }
      }
    }
  },

  "typography": {
    "fontFamily": {
      "sans": {
        "$type": "fontFamily",
        "$value": "Inter",
        "$description": "Figma proxy for the report's system stack: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif. Inter is Figma-default and metrically close. The shipped report loads NO web font (NFR1)."
      },
      "mono": {
        "$type": "fontFamily",
        "$value": "Roboto Mono",
        "$description": "Tabular figures for amount columns and the run console. Figma-default."
      }
    },

    "fontWeight": {
      "$type": "fontWeight",
      "regular":  { "$value": "Regular" },
      "medium":   { "$value": "Medium" },
      "semibold": { "$value": "Semi Bold" },
      "bold":     { "$value": "Bold" }
    },

    "fontSize": {
      "$type": "dimension",
      "xs":   { "$value": 11 },
      "sm":   { "$value": 12 },
      "base": { "$value": 14 },
      "md":   { "$value": 16 },
      "lg":   { "$value": 20 },
      "xl":   { "$value": 24 },
      "xxl":  { "$value": 32 },
      "hero": { "$value": 44 }
    },

    "lineHeight": {
      "$type": "dimension",
      "tight":   { "$value": 1.2 },
      "snug":    { "$value": 1.35 },
      "normal":  { "$value": 1.5 },
      "relaxed": { "$value": 1.65 }
    },

    "letterSpacing": {
      "$type": "dimension",
      "tighter": { "$value": -0.8 },
      "tight":   { "$value": -0.2 },
      "normal":  { "$value": 0 },
      "wide":    { "$value": 0.4 }
    }
  },

  "textStyle": {
    "$type": "typography",
    "$description": "Composite styles. Each becomes one Figma text style and one CSS class.",

    "hero":       { "$value": { "fontFamily": "sans", "fontWeight": "bold",     "fontSize": "hero", "lineHeight": "tight",  "letterSpacing": "tighter" }, "$description": "The single largest number on the dashboard: total spend" },
    "h1":         { "$value": { "fontFamily": "sans", "fontWeight": "bold",     "fontSize": "xxl",  "lineHeight": "tight",  "letterSpacing": "tight" },   "$description": "Report title" },
    "h2":         { "$value": { "fontFamily": "sans", "fontWeight": "semibold", "fontSize": "xl",   "lineHeight": "snug",   "letterSpacing": "tight" },   "$description": "Section headings" },
    "h3":         { "$value": { "fontFamily": "sans", "fontWeight": "semibold", "fontSize": "md",   "lineHeight": "snug",   "letterSpacing": "normal" },  "$description": "Card and panel headings" },
    "bodyLg":     { "$value": { "fontFamily": "sans", "fontWeight": "regular",  "fontSize": "md",   "lineHeight": "normal", "letterSpacing": "normal" },  "$description": "Callout prose" },
    "body":       { "$value": { "fontFamily": "sans", "fontWeight": "regular",  "fontSize": "base", "lineHeight": "normal", "letterSpacing": "normal" },  "$description": "Default body and table cells" },
    "bodyMedium": { "$value": { "fontFamily": "sans", "fontWeight": "medium",   "fontSize": "base", "lineHeight": "normal", "letterSpacing": "normal" },  "$description": "Emphasised table cells, category names" },
    "bodySm":     { "$value": { "fontFamily": "sans", "fontWeight": "regular",  "fontSize": "sm",   "lineHeight": "normal", "letterSpacing": "normal" },  "$description": "Secondary detail lines" },
    "label":      { "$value": { "fontFamily": "sans", "fontWeight": "medium",   "fontSize": "sm",   "lineHeight": "snug",   "letterSpacing": "wide" },    "$description": "Stat tile labels, table headers, badges" },
    "caption":    { "$value": { "fontFamily": "sans", "fontWeight": "regular",  "fontSize": "xs",   "lineHeight": "snug",   "letterSpacing": "wide" },    "$description": "Timestamps, footnotes, axis ticks" },
    "numericLg":  { "$value": { "fontFamily": "mono", "fontWeight": "medium",   "fontSize": "xl",   "lineHeight": "tight",  "letterSpacing": "tight" },   "$description": "Stat tile values" },
    "numericMd":  { "$value": { "fontFamily": "mono", "fontWeight": "medium",   "fontSize": "md",   "lineHeight": "snug",   "letterSpacing": "normal" },  "$description": "Category amounts" },
    "numericSm":  { "$value": { "fontFamily": "mono", "fontWeight": "regular",  "fontSize": "base", "lineHeight": "normal", "letterSpacing": "normal" },  "$description": "Table amount columns. Tabular so digits align." },
    "mono":       { "$value": { "fontFamily": "mono", "fontWeight": "regular",  "fontSize": "sm",   "lineHeight": "relaxed","letterSpacing": "normal" },  "$description": "Console output, file paths, raw descriptions" }
  },

  "spacing": {
    "$type": "dimension",
    "$description": "4px base grid.",
    "none": { "$value": 0 },
    "xxs":  { "$value": 2 },
    "xs":   { "$value": 4 },
    "sm":   { "$value": 8 },
    "md":   { "$value": 12 },
    "lg":   { "$value": 16 },
    "xl":   { "$value": 24 },
    "xxl":  { "$value": 32 },
    "xxxl": { "$value": 48 },
    "huge": { "$value": 64 }
  },

  "radius": {
    "$type": "dimension",
    "none": { "$value": 0 },
    "sm":   { "$value": 6,   "$description": "Badges, inputs, small chips" },
    "md":   { "$value": 10,  "$description": "Buttons, table row hover, stat tiles" },
    "lg":   { "$value": 14,  "$description": "Cards and panels" },
    "pill": { "$value": 999, "$description": "Category badges, status pills" }
  },

  "borderWidth": {
    "$type": "dimension",
    "hairline": { "$value": 1 },
    "thick":    { "$value": 2, "$description": "Focus ring, chart slice gap, emphasised slice ring" }
  },

  "shadow": {
    "$type": "shadow",
    "card":    { "$value": { "color": "#12161D", "alpha": 0.06, "offsetX": 0, "offsetY": 1, "blur": 3,  "spread": 0 }, "$description": "Resting card elevation" },
    "raised":  { "$value": { "color": "#12161D", "alpha": 0.10, "offsetX": 0, "offsetY": 4, "blur": 12, "spread": 0 }, "$description": "Hovered card, sticky corrections tray" },
    "overlay": { "$value": { "color": "#12161D", "alpha": 0.18, "offsetX": 0, "offsetY": 8, "blur": 24, "spread": 0 }, "$description": "Drill-down panel, tooltips" }
  },

  "size": {
    "$type": "dimension",
    "frame": {
      "report":  { "$value": 1280, "$description": "Primary desktop report frame width" },
      "panel":   { "$value": 420,  "$description": "Drill-down side panel width" },
      "console": { "$value": 880,  "$description": "Run console frame width" }
    },
    "chart": {
      "diameter":     { "$value": 340, "$description": "Pie outer diameter at rest" },
      "innerRadius":  { "$value": 0,   "$description": "0 = true pie, not a doughnut. FR17 says pie." },
      "explodeOffset":{ "$value": 12,  "$description": "How far the top-category slice is pulled out. The primary non-colour emphasis cue." },
      "sliceGap":     { "$value": 2,   "$description": "Stroke weight of the separator drawn between adjacent slices" }
    },
    "control": {
      "rowHeight":    { "$value": 44, "$description": "Table row / list row height. Also the minimum touch target." },
      "buttonHeight": { "$value": 36 },
      "inputHeight":  { "$value": 36 },
      "badgeHeight":  { "$value": 22 },
      "tileHeight":   { "$value": 104, "$description": "Stat tile" },
      "iconSize":     { "$value": 16 }
    },
    "gutter": {
      "frame":  { "$value": 160, "$description": "Horizontal gap between screen frames on the Figma canvas" },
      "section":{ "$value": 24,  "$description": "Vertical gap between report sections" }
    }
  },

  "grid": {
    "$type": "dimension",
    "columns":    { "$value": 12 },
    "columnGap":  { "$value": 24 },
    "pageMargin": { "$value": 40 }
  }
}
